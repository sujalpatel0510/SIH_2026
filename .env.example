# =========================================================================
# CampusPilot AI — Environment Configuration Template
# Duplicate this file to .env and configure your local credentials
# =========================================================================

# Database: PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/campuspilot_sih?schema=public"

# Authentication: JWT Secret for cryptographic session signing
JWT_SECRET="campuspilot-enterprise-super-secret-jwt-key-capacity-connect-998877"

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="CampusPilot AI"
NEXT_PUBLIC_APP_TAGLINE="Smart Learning, Smarter Growth"

# =========================================================================
# NVIDIA AI (NVIDIA NIM & API Catalog) Configuration
# Obtain your free API key at https://build.nvidia.com
# =========================================================================
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"

# Active NVIDIA NIM Model (e.g., meta/llama-3.1-70b-instruct, meta/llama-3.2-11b-vision-instruct)
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
